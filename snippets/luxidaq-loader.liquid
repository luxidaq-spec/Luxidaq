<!-- Luxidaq Loader -->
<div id="luxidaq-loader" class="luxidaq-loader">
  <div class="loader-container">
    <div class="loader-text">Luxidaq</div>
    <div class="loader-spinner"></div>
  </div>
</div>

<style>
  .luxidaq-loader {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: linear-gradient(135deg, #1a1a2e 0%, #16213e 100%);
    display: flex;
    justify-content: center;
    align-items: center;
    z-index: 9999;
    animation: fadeOut 0.6s ease-out 2.5s forwards;
  }

  .loader-container {
    text-align: center;
    position: relative;
  }

  .loader-text {
    font-size: 48px;
    font-weight: 800;
    color: #fff;
    letter-spacing: 3px;
    margin-bottom: 30px;
    text-transform: uppercase;
    background: linear-gradient(135deg, #d4af37 0%, #f0e68c 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    animation: slideIn 0.8s ease-out;
  }

  .loader-spinner {
    width: 50px;
    height: 50px;
    border: 4px solid rgba(212, 175, 55, 0.3);
    border-top: 4px solid #d4af37;
    border-radius: 50%;
    margin: 0 auto;
    animation: spin 1s linear infinite;
  }

  @keyframes spin {
    0% { transform: rotate(0deg); }
    100% { transform: rotate(360deg); }
  }

  @keyframes slideIn {
    from {
      opacity: 0;
      transform: translateY(-20px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @keyframes fadeOut {
    from {
      opacity: 1;
      visibility: visible;
    }
    to {
      opacity: 0;
      visibility: hidden;
    }
  }

  @media (max-width: 768px) {
    .loader-text {
      font-size: 32px;
    }

    .loader-spinner {
      width: 40px;
      height: 40px;
      border-width: 3px;
    }
  }
</style>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    // Loader will automatically fade out after 2.5 seconds
    const loader = document.getElementById('luxidaq-loader');
    
    // Optional: Remove from DOM after animation completes
    setTimeout(function() {
      if (loader && loader.parentNode) {
        loader.parentNode.removeChild(loader);
      }
    }, 3200); // Slightly longer than animation duration
  });
</script>
