<section class="wishlist-page page-width">
  {% if customer == nil %}
    <div class="wishlist-page__guest">
      <p class="wishlist-page__eyebrow">Your private collection</p>
      <h1>Save what you love.</h1>
      <p>Sign in or create a Luxidaq account to keep your wishlist available across your visits.</p>
      <div class="wishlist-page__actions">
        <a class="button button--primary" href="{{ routes.account_url }}">Sign in or create account</a>
      </div>
    </div>
  {% else %}
    <div class="wishlist-page__heading">
      <p class="wishlist-page__eyebrow">Welcome back, {{ customer.first_name | default: customer.email | escape }}</p>
      <h1>Your Wishlist</h1>
      <p>Keep the pieces you are considering close at hand.</p>
    </div>
    <div class="wishlist-page__items" data-wishlist-items>
      <p class="wishlist-page__empty">Your wishlist is empty. Tap the heart on a product to save it here.</p>
    </div>
    <p class="wishlist-page__account"><a href="{{ routes.account_url }}">Manage your account details</a></p>
  {% endif %}
</section>

<style>
  .wishlist-page { min-height: 55vh; padding-top: 8rem; padding-bottom: 10rem; background: #111214; color: #f5f2ec; }
  .wishlist-page__guest, .wishlist-page__heading { max-width: 720px; margin: 0 auto 5rem; text-align: center; }
  .wishlist-page__eyebrow { margin: 0 0 1.5rem; color: #b08f4b; font-size: 1.1rem; letter-spacing: .2em; text-transform: uppercase; }
  .wishlist-page h1 { margin: 0 0 2rem; font-size: clamp(4rem, 8vw, 8rem); font-weight: 400; line-height: .95; }
  .wishlist-page p { color: #b9b5ad; font-size: 1.7rem; line-height: 1.5; }
  .wishlist-page__actions { display: flex; justify-content: center; gap: 1rem; margin-top: 3rem; }
  .wishlist-page__items { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 2rem; }
  .wishlist-page__empty { grid-column: 1 / -1; padding: 5rem 2rem; border-top: 1px solid rgba(245,242,236,.16); border-bottom: 1px solid rgba(245,242,236,.16); text-align: center; }
  .wishlist-card { display: block; color: inherit; text-decoration: none; }
  .wishlist-card img { display: block; width: 100%; aspect-ratio: 1 / 1.15; object-fit: cover; background: #f1eee8; }
  .wishlist-card h2 { margin: 1rem 0 .4rem; color: #f5f2ec; font-size: 1.6rem; font-weight: 500; }
  .wishlist-card p { margin: 0; font-size: 1.4rem; }
  .wishlist-card__availability { color: #9bc9a9 !important; font-size: 1.2rem !important; text-transform: uppercase; letter-spacing: .12em; }
  .wishlist-card__availability--sold { color: #e89b8c !important; }
  .wishlist-card__remove { margin-top: 1rem; padding: 0; border: 0; background: transparent; color: #8b4d3d; cursor: pointer; font: inherit; }
  .wishlist-page__account { margin-top: 4rem; text-align: center; }
  .wishlist-page__account a { color: inherit; }
  @media screen and (max-width: 749px) { .wishlist-page { padding-top: 5rem; padding-bottom: 7rem; } .wishlist-page__actions { flex-direction: column; } .wishlist-page__items { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1.2rem; } }
</style>

{% if customer %}
<script>
  (function () {
    var container = document.querySelector('[data-wishlist-items]');
    if (!container) return;
    var stored = JSON.parse(localStorage.getItem('ds_wishlist') || '[]');
    var handles = stored.map(function (item) { return typeof item === 'object' ? item.handle : null; }).filter(Boolean);
    if (!handles.length) return;
    container.innerHTML = '';
    handles.forEach(function (handle) {
      fetch('/products/' + encodeURIComponent(handle) + '.js').then(function (response) { return response.json(); }).then(function (product) {
        var card = document.createElement('article');
        card.className = 'wishlist-card';
        var availability = product.available ? '<p class="wishlist-card__availability">In stock</p>' : '<p class="wishlist-card__availability wishlist-card__availability--sold">Out of stock</p>';
        card.innerHTML = '<a href="' + product.url + '"><img src="' + (product.featured_image || '') + '" alt="' + product.title.replace(/"/g, '&quot;') + '"><h2>' + product.title + '</h2><p>' + Shopify.formatMoney(product.price) + '</p>' + availability + '</a><button class="wishlist-card__remove" type="button">Remove</button>';
        card.querySelector('button').addEventListener('click', function () {
          var next = JSON.parse(localStorage.getItem('ds_wishlist') || '[]').filter(function (item) { return (typeof item === 'object' ? item.handle : '') !== handle; });
          localStorage.setItem('ds_wishlist', JSON.stringify(next));
          card.remove();
          if (!container.children.length) container.innerHTML = '<p class="wishlist-page__empty">Your wishlist is empty. Tap the heart on a product to save it here.</p>';
        });
        container.appendChild(card);
      });
    });
  }());
</script>
{% endif %}

{% schema %}
{"name":"Wishlist page","settings":[]}
{% endschema %}
