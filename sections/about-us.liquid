<section class="about-page section-{{ section.id }}">
  <div class="about-page__hero">
    <div class="about-page__hero-content">
      <p class="about-page__eyebrow">The Luxidaq story</p>
      <h1>{{ section.settings.heading }}</h1>
      <p class="about-page__intro">{{ section.settings.intro }}</p>
    </div>
    <div class="about-page__hero-line" aria-hidden="true"></div>
  </div>

  <div class="about-page__story page-width">
    <div class="about-page__story-copy">
      <p class="about-page__eyebrow">Everyday, elevated</p>
      <h2>{{ section.settings.story_heading }}</h2>
      <div class="rte">{{ section.settings.story_text }}</div>
    </div>
    <div class="about-page__story-media{% unless section.settings.image != blank %} about-page__story-media--empty{% endunless %}">
      {% if section.settings.image != blank %}
        {{ section.settings.image | image_url: width: 1200 | image_tag: loading: 'lazy', widths: '400, 600, 800, 1200', sizes: '(min-width: 990px) 50vw, 100vw', alt: section.settings.image.alt | default: section.settings.heading }}
      {% else %}
        <span>Made for the moments that matter</span>
      {% endif %}
    </div>
  </div>

  <div class="about-page__values page-width">
    <div class="about-page__values-heading">
      <p class="about-page__eyebrow">What we believe</p>
      <h2>Thoughtful by design.</h2>
    </div>
    <div class="about-page__value-list">
      {% for block in section.blocks %}
        <article class="about-page__value" {{ block.shopify_attributes }}>
          <span class="about-page__value-number">0{{ forloop.index }}</span>
          <h3>{{ block.settings.heading }}</h3>
          <p>{{ block.settings.text }}</p>
        </article>
      {% endfor %}
    </div>
  </div>

  <div class="about-page__closing">
    <p class="about-page__eyebrow">Find your everyday luxury</p>
    <h2>{{ section.settings.closing_heading }}</h2>
    {% if section.settings.button_label != blank %}
      <a class="button button--primary" href="{{ section.settings.button_link | default: routes.all_products_collection_url }}">
        {{ section.settings.button_label }}
      </a>
    {% endif %}
  </div>
</section>

<style>
  .section-{{ section.id }} {
    --about-ink: #171716;
    --about-muted: #68655d;
    --about-line: rgba(23, 23, 22, 0.16);
    background: #f5f2ec;
    color: var(--about-ink);
  }

  .section-{{ section.id }} .about-page__hero {
    min-height: min(78vh, 760px);
    padding: 10rem 8vw 7rem;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    position: relative;
    overflow: hidden;
    background: #171716;
    color: #f5f2ec;
  }

  .section-{{ section.id }} .about-page__hero::before {
    content: '';
    position: absolute;
    inset: 0;
    opacity: 0.5;
    background: radial-gradient(circle at 75% 25%, rgba(191, 160, 91, 0.3), transparent 36%), linear-gradient(135deg, #171716 10%, #29261f 100%);
  }

  .section-{{ section.id }} .about-page__hero-content,
  .section-{{ section.id }} .about-page__hero-line {
    position: relative;
    z-index: 1;
  }

  .section-{{ section.id }} .about-page__eyebrow {
    margin: 0 0 1.5rem;
    color: #bfa05b;
    font-size: 1.1rem;
    letter-spacing: 0.2em;
    line-height: 1.4;
    text-transform: uppercase;
  }

  .section-{{ section.id }} h1,
  .section-{{ section.id }} h2,
  .section-{{ section.id }} h3,
  .section-{{ section.id }} p {
    overflow-wrap: anywhere;
  }

  .section-{{ section.id }} h1 {
    max-width: 950px;
    margin: 0;
    font-size: clamp(4.8rem, 11vw, 12rem);
    font-weight: 400;
    letter-spacing: 0;
    line-height: 0.88;
  }

  .section-{{ section.id }} .about-page__intro {
    max-width: 620px;
    margin: 2.5rem 0 0;
    color: rgba(245, 242, 236, 0.76);
    font-size: clamp(1.6rem, 2.4vw, 2.4rem);
    line-height: 1.35;
  }

  .section-{{ section.id }} .about-page__hero-line {
    width: 100%;
    height: 1px;
    margin-top: 5rem;
    background: rgba(245, 242, 236, 0.3);
  }

  .section-{{ section.id }} .about-page__story {
    display: grid;
    grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.15fr);
    gap: clamp(3rem, 8vw, 9rem);
    align-items: center;
    padding-top: clamp(7rem, 12vw, 13rem);
    padding-bottom: clamp(7rem, 12vw, 13rem);
  }

  .section-{{ section.id }} h2 {
    margin: 0 0 2rem;
    font-size: clamp(3.2rem, 5vw, 6.5rem);
    font-weight: 400;
    letter-spacing: 0;
    line-height: 0.95;
  }

  .section-{{ section.id }} .about-page__story .rte {
    max-width: 470px;
    color: var(--about-muted);
    font-size: 1.7rem;
    line-height: 1.65;
  }

  .section-{{ section.id }} .about-page__story-media {
    aspect-ratio: 4 / 5;
    overflow: hidden;
    background: #d4c9b8;
  }

  .section-{{ section.id }} .about-page__story-media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .section-{{ section.id }} .about-page__story-media--empty {
    display: flex;
    align-items: flex-end;
    padding: 3rem;
    background: linear-gradient(145deg, #d4c9b8, #a9977d 60%, #6f5e4c);
    color: #f5f2ec;
    font-size: clamp(2rem, 4vw, 4.8rem);
    line-height: 1;
  }

  .section-{{ section.id }} .about-page__values {
    display: grid;
    grid-template-columns: minmax(220px, 0.8fr) minmax(0, 1.2fr);
    gap: 5rem;
    padding-top: 4rem;
    padding-bottom: clamp(7rem, 12vw, 13rem);
    border-top: 1px solid var(--about-line);
  }

  .section-{{ section.id }} .about-page__value-list {
    border-top: 1px solid var(--about-line);
  }

  .section-{{ section.id }} .about-page__value {
    display: grid;
    grid-template-columns: 4rem minmax(0, 0.8fr) minmax(0, 1fr);
    gap: 1rem;
    align-items: start;
    padding: 2rem 0;
    border-bottom: 1px solid var(--about-line);
  }

  .section-{{ section.id }} .about-page__value-number {
    color: #b08f4b;
    font-size: 1.2rem;
    letter-spacing: 0.1em;
  }

  .section-{{ section.id }} .about-page__value h3 {
    margin: 0;
    font-size: 2.1rem;
    font-weight: 500;
    line-height: 1.1;
  }

  .section-{{ section.id }} .about-page__value p {
    margin: 0;
    color: var(--about-muted);
    font-size: 1.5rem;
    line-height: 1.5;
  }

  .section-{{ section.id }} .about-page__closing {
    padding: clamp(7rem, 13vw, 15rem) 2rem;
    background: #b08f4b;
    color: #171716;
    text-align: center;
  }

  .section-{{ section.id }} .about-page__closing .about-page__eyebrow {
    color: #171716;
  }

  .section-{{ section.id }} .about-page__closing h2 {
    max-width: 850px;
    margin: 0 auto 3rem;
  }

  @media screen and (max-width: 749px) {
    .section-{{ section.id }} .about-page__hero {
      min-height: 72vh;
      padding: 7rem 2rem 4rem;
    }

    .section-{{ section.id }} h1 {
      font-size: clamp(4.5rem, 18vw, 8rem);
    }

    .section-{{ section.id }} .about-page__intro {
      font-size: 1.5rem;
    }

    .section-{{ section.id }} .about-page__story,
    .section-{{ section.id }} .about-page__values {
      display: block;
      padding-left: 2rem;
      padding-right: 2rem;
    }

    .section-{{ section.id }} .about-page__story-copy {
      margin-bottom: 4rem;
    }

    .section-{{ section.id }} .about-page__values-heading {
      margin-bottom: 4rem;
    }

    .section-{{ section.id }} .about-page__value {
      grid-template-columns: 3rem minmax(0, 1fr);
    }

    .section-{{ section.id }} .about-page__value p {
      grid-column: 2;
    }
  }
</style>

{% schema %}
{
  "name": "About Us",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Main heading",
      "default": "Luxidaq"
    },
    {
      "type": "textarea",
      "id": "intro",
      "label": "Introduction",
      "default": "A considered approach to the things you live with, wear, and love."
    },
    {
      "type": "text",
      "id": "story_heading",
      "label": "Story heading",
      "default": "Luxury should feel lived in."
    },
    {
      "type": "richtext",
      "id": "story_text",
      "label": "Story text",
      "default": "<p>Luxidaq was created for people who believe the everyday deserves more attention. We bring together thoughtful design, lasting quality, and a sense of ease to make products that belong naturally in your life.</p><p>From the first idea to the final detail, we choose with intention. The result is a collection that feels personal, practical, and quietly distinctive.</p>"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Story image"
    },
    {
      "type": "text",
      "id": "closing_heading",
      "label": "Closing heading",
      "default": "Make room for better everyday things."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Explore the collection"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    }
  ],
  "blocks": [
    {
      "type": "value",
      "name": "Value",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Intentional design"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Text",
          "default": "Every detail has a reason, from the first sketch to the way a piece feels in your hands."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "About Us",
      "blocks": [
        { "type": "value", "settings": { "heading": "Intentional design", "text": "Every detail has a reason, from the first sketch to the way a piece feels in your hands." } },
        { "type": "value", "settings": { "heading": "Lasting quality", "text": "We look beyond the moment to create things you will return to again and again." } },
        { "type": "value", "settings": { "heading": "Quiet confidence", "text": "The best luxury does not need to announce itself. It simply feels right." } }
      ]
    }
  ]
}
{% endschema %}
